{
  "name": "thyme",
  "version": "1.0.0",
  "description": "A movie and TV show database with search functionality",
  "main": "dist/index.js",
  "type": "module",
  "volta": {
    "node": "24.12.0",
    "yarn": "1.22.22"
  },
  "scripts": {
    "build": "tsc",
    "build:site": "tsx scripts/build.ts && vite build --config web/vite.config.ts",
    "wasm:bundle": "vite build --config wasm/vite.config.ts",
    "wasm:componentize": "jco componentize wasm/dist/index.js -w node_modules/trailbase-wasm/wit -o wasm/dist/component.wasm",
    "wasm:build": "yarn wasm:bundle && yarn wasm:componentize && mkdir -p traildepot/wasm && cp wasm/dist/component.wasm traildepot/wasm/component.wasm",
    "dev": "tsc --watch",
    "clean": "rm -rf dist wasm/dist traildepot/wasm",
    "rebuild": "yarn clean && yarn build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "type-check": "tsc --noEmit && tsc -p web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check-deps": "tsx scripts/check-deps.ts",
    "prepare": "husky install",
    "pre-commit": "lint-staged"
  },
  "keywords": [
    "movies",
    "tv-shows",
    "database",
    "search",
    "typescript",
    "sqlite"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.0.5",
    "@bytecodealliance/jco": "^1.36.1",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "fs-extra": "^11.3.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.2",
    "trailbase-wasm": "0.6.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vite": "^8.3.2"
  },
  "dependencies": {},
  "lint-staged": {
    "*.{ts,tsx}": [
      "biome check --write",
      "biome format --write"
    ],
    "*.{js,jsx,json}": [
      "biome format --write"
    ]
  },
  "engines": {
    "node": ">=22.20.0",
    "yarn": ">=1.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/thyme.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/thyme/issues"
  },
  "homepage": "https://github.com/yourusername/thyme#readme"
}
